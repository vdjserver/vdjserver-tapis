{
    "id":"cellranger-ls6",
    "version":"10.0.0",
    "description":"CellRanger on Lonestar6",
    "runtime":"ZIP",
    "runtimeOptions": ["NONE"],
    "containerImage":"tapis://data-storage.vdjserver.org/apps/cellranger-ls6-10.0.0.tgz",
    "jobType":"BATCH",
    "jobAttributes": {
        "description": "default job description",
        "execSystemId": "test-ls6.tacc.utexas.edu",
        "fileInputs":[
            { "name":"cellranger_image", "inputMode": "FIXED", "envKey":"cellranger_image", "sourceUrl":"tapis://data-storage.vdjserver.org/singularity/cellranger-10.0.0.sif", "targetPath":"cellranger-10.0.0.sif" },
            { "name":"repcalc_image", "inputMode": "FIXED", "envKey":"repcalc_image", "sourceUrl":"tapis://data-storage.vdjserver.org/singularity/repcalc-v2.3-imm4.4.sif", "targetPath":"repcalc-v2.3-imm4.4.sif" },
            { "name":"analysis_provenance", "inputMode": "REQUIRED", "envKey":"analysis_provenance", "targetPath":"." },
            { "name":"AIRRMetadata", "inputMode": "REQUIRED", "envKey":"AIRRMetadata", "targetPath":"." }
        ],
        "fileInputArrays":[
            {  "name":"germline_archives", "inputMode": "FIXED", "targetDir":".",
            "sourceUrls": [ "tapis://data-storage.vdjserver.org/akc/germlines/db.2019.01.23.tgz",
                            "tapis://data-storage.vdjserver.org/akc/germlines/db.2026.01.12.tgz"]},
            { "name":"JobFiles", "inputMode": "OPTIONAL", "targetDir":"." },
            { "name":"ForwardPairedFile", "inputMode": "OPTIONAL", "targetDir":"." },
            { "name":"ReversePairedFile", "inputMode": "OPTIONAL", "targetDir":"." }
        ],
        "parameterSet": {
            "logConfig": {
                "stdoutFilename": "tapisjob.out",
                "stderrFilename": "tapisjob.err"
            },
            "containerArgs": [
            ],
            "appArgs": [
            ],
            "envVariables": [
                {"key": "species", "inputMode": "REQUIRED", "value": "human" },
                {"key": "strain", "inputMode": "INCLUDE_BY_DEFAULT" },
                {"key": "germline_db_TR", "inputMode": "REQUIRED" },
                {"key": "germline_db_IG", "inputMode": "REQUIRED" },
                {"key": "ForwardPairedFile", "inputMode": "INCLUDE_BY_DEFAULT" },
                {"key": "ReversePairedFile", "inputMode": "INCLUDE_BY_DEFAULT" }
            ]
        }
    }
}